# Конфигурация по умолчанию для нового роутера (копируется в образ).
# Ваша рабочая конфигурация — config/router.yaml; этот файл она не меняет.
# Конфигурация роутера — единый источник правды (аналог /export RouterOS)
# Роли интерфейсов отделены от имён: в GNS3 это eth0/eth1, на железе enp1s0 и т.п.

system:
  identity: outpost-gate-pro

interface-lists:
  WAN: [eth0]
  LAN: [eth1]

ip:
  addresses:
    - { address: 192.168.1.1/24, interface: eth1 }
  # routes: []
  # dhcp-client: { interface: eth0 }
  # dhcp-server: { interface: eth1, pool: 192.168.1.10-192.168.1.254 }
  # firewall:
  #   nat:
  #     - { chain: srcnat, out-interface-list: WAN, action: masquerade }
